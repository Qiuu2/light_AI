[Unit]
Description=AI Speaker FastAPI Service
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ai-speaker
Group=ai-speaker
WorkingDirectory=/opt/ai-speaker/app
Environment="PATH=/opt/ai-speaker/miniconda3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/etc/ai-speaker/ai-speaker.env
ExecStart=/opt/ai-speaker/miniconda3/bin/python -m uvicorn backend.api_public:app --host 0.0.0.0 --port 5018
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
LimitNOFILE=65535
UMask=0027

[Install]
WantedBy=multi-user.target
